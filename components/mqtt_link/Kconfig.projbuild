menu "FMS: duong MQTT (mqtt_link)"

config MQTT_LINK_ENABLE
    bool "Bat duong MQTT chay song song voi HTTP"
    default y
    help
      Giai doan 2: phat so do len broker MQTT BEN CANH duong HTTP dang
      co. Tat di thi node chay y het truoc day.

config MQTT_LINK_BROKER_URI
    string "Dia chi broker"
    default ""
    depends on MQTT_LINK_ENABLE
    help
      Vi du: mqtt://192.168.5.190:1883
      De TRONG thi component khong chay — node van len HTTP binh thuong.
      Giai doan sau se doi sang mqtts:// kem chung chi.

config MQTT_LINK_USERNAME
    string "Ten dang nhap broker"
    default ""
    depends on MQTT_LINK_ENABLE

config MQTT_LINK_PASSWORD
    string "Mat khau broker"
    default ""
    depends on MQTT_LINK_ENABLE
    help
      LUU Y: gia tri nay bi nung vao firmware va nam trong sdkconfig.
      Chap nhan duoc o giai doan thu nghiem; giai doan 4 se chuyen sang
      chung danh rieng tung thiet bi nap qua trang /setup cua node.

config MQTT_LINK_TOPIC_BASE
    string "Goc chu de"
    default "fms"
    depends on MQTT_LINK_ENABLE
    help
      Chu de day du se la <goc>/<serial>/meas va <goc>/<serial>/status.

config MQTT_LINK_BATCH_MAX
    int "So ban ghi toi da moi goi"
    default 32
    range 1 200
    depends on MQTT_LINK_ENABLE

config MQTT_LINK_FLUSH_MS
    int "Thoi gian gom toi da (ms)"
    default 2000
    range 50 30000
    depends on MQTT_LINK_ENABLE
    help
      Gom du BATCH_MAX ban ghi HOAC het ngan nay thi gui. Nho thi so ve
      nhanh nhung goi vun hon.

config MQTT_LINK_DEADBAND_MILLI
    int "Vung chet (phan nghin cua don vi)"
    default 0
    range 0 1000000
    depends on MQTT_LINK_ENABLE
    help
      Bao-khi-doi: thay doi nho hon nguong nay thi khong phat. Don vi la
      1/1000 don vi kenh, nen 500 = 0,5 g voi can.

      0 nghia la phat khi gia tri doi BAT KY luong nao — da du de bo 75%
      luu luong (count1/pedal1/count2 lap lai so 0 moi 200 ms, do
      18/09/2026) ma khong bo sot mot thay doi that nao.

config MQTT_LINK_MAX_SILENCE_MS
    int "Khoang lang toi da (ms)"
    default 10000
    range 1000 600000
    depends on MQTT_LINK_ENABLE
    help
      Gia tri khong doi van phai duoc nhac lai sau ngan nay. KHONG dat qua
      lon: kenh ben Odoo co max_age_ms, im lau hon nguong do thi o gia tri
      chuyen xam va nut [Dat] bi chan — da gap that voi scale_esp32.

config MQTT_LINK_BODY_BYTES
    int "Bo dem dung goi JSON (byte)"
    default 4096
    range 512 16384
    depends on MQTT_LINK_ENABLE
    help
      Bo dem TINH, cap phat mot lan luc nap chuong trinh. Mot ban ghi ton
      khoang 110 byte, nen 4096 chua duoc ~35 ban ghi; day bo dem thi lo
      bi cat va phan con lai di o lo sau, khong mat gi.

      KHONG nen tang to: day la RAM noi, va con node nay chi con ~48 KB
      heap trong.

endmenu
